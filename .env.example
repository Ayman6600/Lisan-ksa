PORT=8080
ENVIRONMENT=development

# Neon PostgreSQL connection string (pooled recommended):
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
AUTO_MIGRATE=true

# Redis connection string:
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_RPM=60
MAX_BODY_SIZE_BYTES=65536

# Providers
TRANSLATION_PROVIDER=gemini
TRANSLATION_API_KEY=
EXPLANATION_PROVIDER=gemini
EXPLANATION_API_KEY=
OCR_PROVIDER=gemini
OCR_API_KEY=
ASSEMBLYAI_API_KEY=
