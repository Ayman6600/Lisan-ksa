PORT=8080
ENVIRONMENT=development

# -------------------------------------------------------------
# Neon PostgreSQL:
# Copy the pooled connection string from the Neon Console:
# Example: postgresql://username:password@ep-cool-fog-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# -------------------------------------------------------------
DATABASE_URL=
AUTO_MIGRATE=true

# -------------------------------------------------------------
# Redis:
# Local Docker: redis://localhost:6379/0
# Upstash/Cloud: rediss://default:password@endpoint.upstash.io:6379
# (If unset, the API uses a fail-safe in-memory rate limiter)
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_RPM=60
MAX_BODY_SIZE_BYTES=65536

# -------------------------------------------------------------
# Translation Provider (Configure when ready for Phase 2):
# TRANSLATION_PROVIDER=google | aws | mock
# TRANSLATION_API_KEY=
# -------------------------------------------------------------
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
